# ═══════════════════════════════════════════════════════════════════
# Apex Logistics AI — Root .dockerignore
# Production build context exclusion rules
# ═══════════════════════════════════════════════════════════════════

# ── Version Control ──────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
.agents/

# ── Virtual Environments ─────────────────────────────────────────
venv/
.venv/
env/
ENV/
backend/venv/
*/venv/

# ── Python Cache & Build Artifacts ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Environment & Secrets ────────────────────────────────────────
.env
.env.local
.env.development
.env.production
*.pem
*.key
*.cert

# ── Database & State Files ───────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite3
*.bak
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-shm
backend/data/*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal

# ── Runtime Storage & Logs ───────────────────────────────────────
logs/
*.log
backend/logs/
data/vector_store/
data/kb_uploads/
data/knowledge_metadata/
data/chroma_db/

# ── Testing & Linters ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/
backend/tests/

# ── IDE & Operating System ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Node / Frontend Tooling ──────────────────────────────────────
node_modules/
.npm/

# ── Academic Research Drafts & Non-Production Docs ───────────────
*.docx
*.doc
*.pdf
*.pptx
PHD_DISSERTATION_AND_PAPERS_BLUEPRINT.md
LOGISTICS_TRANSFORMATION_PROGRESS.md
Paper1/
Paper2/
Paper3/
