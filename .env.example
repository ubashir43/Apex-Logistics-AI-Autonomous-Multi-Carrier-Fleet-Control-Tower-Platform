# ═══════════════════════════════════════════════════════════════════
# Apex Logistics AI — Environment Configuration Template
# Copy this file to .env and configure your production values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL in enterprise production:
# DATABASE_URL=postgresql://postgres:password@postgres:5432/apex_logistics

# ── Security & Authentication (MANDATORY IN PRODUCTION) ─────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM Provider (Autonomous Dispatch & WISMO Resolution) ────────
# Supports OpenRouter, Anthropic, OpenAI, or any OpenAI-compatible provider
LLM_API_KEY=your-llm-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4
LLM_FALLBACK_MODEL=anthropic/claude-3-haiku

# ── Vector Store & Multilingual Embeddings ─────────────────────
VECTOR_STORE_DIR=data/vector_store
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Logistics Telemetry & Prediction Parameters ─────────────────
HUBER_DELTA=1.35
CIRCUITY_EXPONENT=0.88
CIRCUITY_BASELINE=1.27
ENABLE_TELEMETRY_STREAM=true
DEFAULT_CARRIER_LIST=DHL,FedEx,UPS,TCS

# ── Networking & CORS ───────────────────────────────────────────
CORS_ORIGINS=*
PORT=8000
HOST=0.0.0.0

# ── Application Runtime ─────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# ── Public URL (Used for API gateway and tracking links) ─────────
BACKEND_URL=http://localhost:8000
